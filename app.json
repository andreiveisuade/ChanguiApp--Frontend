{
  "expo": {
    "name": "ChanguiApp",
    "slug": "changuiapp",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "changuiapp",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.changuiapp"
    },
    "android": {
      "package": "com.changuiapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir a ChanguiApp acceder a tu cámara para escanear códigos de barras."
        }
      ],
      "expo-font",
      "expo-sqlite"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c2548e84-69b4-4ce8-ae9f-b7010a59fb5d"
      }
    },
    "owner": "andreiveis"
  }
}
