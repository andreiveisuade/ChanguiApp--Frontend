# ======================================
# ChanguiApp Frontend — Variables de Entorno
# ======================================
# Copiar este archivo a .env y completar con los valores reales.
# NUNCA commitear el archivo .env (está en .gitignore).
# Las credenciales reales se comparten por el grupo de WhatsApp.

# --- Backend API ---
# En desarrollo local: http://localhost:3000
# En produccion (Render): https://tu-app.onrender.com
EXPO_PUBLIC_API_URL=https://changuiapp-backend.onrender.com

# --- Supabase (mismas credenciales que el backend) ---
# Obtener de: https://supabase.com → tu proyecto → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://ryyzicjwxepjqfmidnjt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<tu anon key>

# Nota: el login con Google usa el OAuth de Supabase (supabase.auth.signInWithOAuth),
# configurado en el dashboard de Supabase. No requiere client IDs en el front.